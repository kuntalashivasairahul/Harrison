# Copy these values to backend/.env. The main key and numbered keys are each
# distinct pool members, in this order: main, _1 through _10.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Stage 1: Groq optimizes queries and is the last-resort draft failover.
# Disabled unless both values are set.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_OPTIMIZER_MODEL=openai/gpt-oss-20b

# Mistral drafts only when both Gemini deployments are rate-limited. Never
# verifies. Disabled unless both values are set.
MISTRAL_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_DRAFT_MODEL=mistral-large-latest

# Bounded request-path reliability controls.
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
LLM_PROVIDER_COOLDOWN_SECONDS=60
LLM_OPTIMIZER_DEADLINE_SECONDS=8
LLM_DRAFT_DEADLINE_SECONDS=60
LLM_VERIFIER_DEADLINE_SECONDS=60
LLM_DRAFT_MAX_ATTEMPTS=3
LLM_VERIFIER_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Application settings (HARRISON_*)
# ---------------------------------------------------------------------------
# All optional; the defaults shown are what the code falls back to. Until now
# none of these were documented here, so the only way to discover them was to
# grep os.getenv() across backend/.

# Page renders. storage/pages/full is 3.8 GB of full-resolution scans of a
# licensed textbook. On any public deployment leave this FALSE: /pages is an
# unauthenticated StaticFiles mount with predictable filenames
# (page_{N}_full.png), so serving the full renders publishes a complete,
# scrapeable copy of the book. False makes resolve_page_urls() point full_url
# at the WebP thumbnail instead of a file that is not there.
HARRISON_PAGE_FULL_RES=true

# Admin surface. /admin/* is DISABLED entirely when this is unset, which is the
# right default. Set it only if you need cache administration, and then use a
# long random value.
HARRISON_ADMIN_TOKEN=

# Request bounds. The rate limiter is in-process and assumes a single worker.
# It identifies clients by request.client.host, which uvicorn rewrites from
# X-Forwarded-For when --forwarded-allow-ips is permissive -- so a public
# deployment must bind to localhost behind a trusted proxy, or this limit can
# be bypassed with a spoofed header.
HARRISON_RATE_LIMIT_PER_MINUTE=30
HARRISON_MAX_QUERY_CHARS=2000

# Browser origins allowed to call the API cross-site. Empty means none, which
# is correct when the UI is served from the same origin as the API.
HARRISON_CORS_ORIGINS=

# Logging. Read by configure_logging(), which must run before any other
# backend.* import in an entry point.
HARRISON_LOG_LEVEL=INFO

# Retrieval diagnostics. Logging queries means writing user-entered clinical
# questions to disk; leave off unless you are actively debugging retrieval.
HARRISON_RETRIEVAL_LOGS=false
HARRISON_RETRIEVAL_LOG_QUERIES=false
HARRISON_RETRIEVAL_LOG_RETENTION=200

# Cache-busting suffix for static assets. Defaults to a build timestamp.
HARRISON_ASSET_VERSION=

# ---------------------------------------------------------------------------
# Deployment (only needed when the corpus is not on local disk)
# ---------------------------------------------------------------------------
# Read by scripts/fetch_corpus.py, never by anything under backend/.
# HARRISON_CORPUS_REPO is "username/dataset-name", not a URL.
HARRISON_CORPUS_REPO=
HF_TOKEN=
