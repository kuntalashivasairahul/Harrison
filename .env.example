# Copy these values to backend/.env. The main key and numbered keys are each
# distinct pool members, in this order: main, _1 through _10.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Stage 1: Groq optimizes queries and is the last-resort draft failover.
# Disabled unless both values are set.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_OPTIMIZER_MODEL=openai/gpt-oss-20b

# Mistral drafts only when both Gemini deployments are rate-limited. Never
# verifies. Disabled unless both values are set.
MISTRAL_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_DRAFT_MODEL=mistral-large-latest

# Bounded request-path reliability controls.
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
LLM_PROVIDER_COOLDOWN_SECONDS=60
LLM_OPTIMIZER_DEADLINE_SECONDS=8
LLM_DRAFT_DEADLINE_SECONDS=60
LLM_VERIFIER_DEADLINE_SECONDS=60
LLM_DRAFT_MAX_ATTEMPTS=3
LLM_VERIFIER_MAX_ATTEMPTS=2
